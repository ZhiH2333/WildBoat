# Copy to .env for local Docker Compose. Never commit real secrets.

APP_ENV=development
HTTP_ADDR=0.0.0.0:8080
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

POSTGRES_DB=wildboat
POSTGRES_USER=wildboat
POSTGRES_PASSWORD=change-me-local-only

# Used by the API process outside Compose, or overridden inside Compose.
DATABASE_URL=postgres://wildboat:change-me-local-only@localhost:5432/wildboat?sslmode=disable

# HS256 signing key for access tokens (min 32 characters). Generate a unique value per environment.
TOKEN_SIGNING_KEY=local-dev-only-change-me-32chars!!

# Access tokens are short-lived; refresh tokens rotate and are stored hashed.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Email delivery: none | dev
# - none: verification/reset tokens are stored but not delivered or exposed (no fake "email sent").
# - dev: allowed only when APP_ENV is development/test/local; returns single-use tokens in API JSON.
EMAIL_MODE=dev

# In-process fixed-window rate limit for auth endpoints (per IP+route).
# Production deployments should also enforce limits at the ingress/WAF layer.
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW=1m
