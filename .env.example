# Copy to .env for local Docker Compose. Never commit real secrets.

APP_ENV=development
HTTP_ADDR=0.0.0.0:8080
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

POSTGRES_DB=wildboat
POSTGRES_USER=wildboat
POSTGRES_PASSWORD=change-me-local-only

# Used by the API process outside Compose, or overridden inside Compose.
DATABASE_URL=postgres://wildboat:change-me-local-only@localhost:5432/wildboat?sslmode=disable
